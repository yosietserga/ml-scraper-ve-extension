# SHEETS_API_URL
# Paste the full Google Apps Script web app URL here.
# Must end with /exec (the deployment URL, NOT /dev).
# The ?action=data query param is appended automatically by the /api/data proxy.
#
# Example:
# SHEETS_API_URL=https://script.google.com/macros/s/AKfycbwXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
SHEETS_API_URL=https://script.google.com/macros/s/AKfyc.../exec
