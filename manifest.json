{
  "manifest_version": 3,
  "name": "MercadoLibre VE Scraper Master",
  "version": "6.18.0",
  "description": "Scraper avanzado para MercadoLibre Venezuela con almacenamiento centralizado, sincronización entre pestañas, extracción profunda de vendedores, multi-sheet bidireccional y captura de oportunidades móviles.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MercadoLibre VE Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*.mercadolibre.com.ve/*",
    "https://mercadolibre.com.ve/*",
    "https://api.mercadolibre.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolibre.com.ve/*",
        "https://mercadolibre.com.ve/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "analysis.html", "analysis.css", "analysis.js",
        "error-log.html", "error-log.js",
        "google-apps-script.js",
        "dashboard.html", "dashboard.css", "dashboard.js",
        "opportunities.html", "opportunities.css", "opportunities.js"
      ],
      "matches": [
        "https://*.mercadolibre.com.ve/*",
        "https://mercadolibre.com.ve/*"
      ]
    }
  ]
}
